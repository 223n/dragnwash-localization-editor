# 依存
node_modules/

# 検査やビルドの出力
*.log

# エディタと OS
.DS_Store
.vscode/settings.json
.idea/

# 環境変数と認証情報。
# npm login が作る .npmrc にはトークンが入るため、リポジトリには入れない
.env
.env.*
!.env.example
.npmrc

# Go
/dist/
*.exe
*.test
/dwloc

# 実行の記録
/logs/

# 試験の出力。カバレッジの報告と生データ（coverage/）と、Playwright の出力（test-results/）。
# playwright-report/ と blob-report/ は既定の設定では作らないが、--reporter=html などで作られる
/coverage/
/test-results/
playwright-report/
blob-report/
