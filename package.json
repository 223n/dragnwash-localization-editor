{
  "name": "dragnwash-localization-editor",
  "version": "0.9.0",
  "private": true,
  "description": "Drag'n Wash Localizationの翻訳作業を助けるクロスプラットフォームなエディター。",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "npm run lint:md && npm run lint:ja",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "lint:ja": "textlint .",
    "lint:ja:fix": "textlint --fix .",
    "test:e2e": "node e2e/coverage.mjs clean && playwright test -c e2e && node e2e/coverage.mjs report",
    "test:e2e:report": "node e2e/coverage.mjs report"
  },
  "coverageThresholds": {
    "e2e": {
      "lines": 0,
      "statements": 0,
      "functions": 0,
      "branches": 0
    }
  },
  "devDependencies": {
    "@223n/lint-config-ja": "^1.1.0",
    "@playwright/test": "^1.63.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "markdownlint-cli2": "^0.23.2",
    "textlint": "^15.8.0",
    "v8-to-istanbul": "^9.3.0"
  },
  "overrides": {
    "smol-toml": "^1.7.1"
  }
}
