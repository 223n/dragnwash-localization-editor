{
  "name": "dragnwash-localization-editor",
  "version": "0.8.1",
  "private": true,
  "description": "Drag'n Wash Localizationの翻訳作業を助けるクロスプラットフォームなエディター。",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "npm run lint:md && npm run lint:ja",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "lint:ja": "textlint .",
    "lint:ja:fix": "textlint --fix ."
  },
  "devDependencies": {
    "@223n/lint-config-ja": "^1.1.0",
    "markdownlint-cli2": "^0.23.2",
    "textlint": "^15.8.0"
  },
  "overrides": {
    "smol-toml": "^1.7.1"
  }
}
